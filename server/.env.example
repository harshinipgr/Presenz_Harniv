# Copy this file to ".env" and edit the values.

# Port the server listens on
PORT=4000

# Faculty must type this code when they sign up (students cannot become faculty without it).
FACULTY_SIGNUP_CODE=CIT-FACULTY-2026

# Attendance window (24-hour clock, in the time zone below). Only one attendance per student per day.
TIME_ZONE=Asia/Kolkata
WINDOW_START=07:20
WINDOW_END=08:05

# Face match threshold (cosine similarity, 0-1). Higher = stricter.
FACE_MATCH_THRESHOLD=0.60

# Dynamic QR refresh interval in seconds
QR_WINDOW_SECONDS=15

# Optional: fixed secrets. If left empty, random secrets are generated once and saved in data/secrets.json
JWT_SECRET=
QR_SECRET=
FACE_KEY=
